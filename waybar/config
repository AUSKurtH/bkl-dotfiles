 {
      "layer": "top",
      "position": "top",
      "height": 30,
      "modules-left": ["hyprland/workspaces"],
      "modules-center": ["clock"],
      "modules-right": ["cpu", "memory", "network", "pulseaudio", "tray"],

      "hyprland/workspaces": {
          "disable-scroll": true,
          "all-outputs": true
      },
      "clock": {
          "format": "{:%a %d %b  %H:%M}",
          "tooltip": false
      },
      "cpu": {
          "format": "CPU {usage}%",
          "interval": 2
      },
      "memory": {
          "format": "RAM {}%",
          "interval": 2
      },
      "network": {
          "format-wifi": "{essid} ({signalStrength}%)",
          "format-ethernet": "ETH",
          "format-disconnected": "No Network"
      },
      "pulseaudio": {
          "format": "VOL {volume}%",
          "format-muted": "MUTED"
      },
      "tray": {
          "spacing": 10
      }
  }
